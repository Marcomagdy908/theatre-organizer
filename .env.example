# Firebase Configuration Environment Variables for Opera Royale Theater Seat Management
# Copy this file to .env and replace with your Firebase Project Web App Credentials:

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-theater-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-theater-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-theater-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
